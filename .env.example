# StreamFlix Environment Configuration Example
DEBUG=True
SECRET_KEY=streamflix-insecure-dev-key-change-in-production-!#@$%^&*()

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=streamflix_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay Configuration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Production / Render (set these in the Render dashboard, not here) ---
# DEBUG=False
# DB_SSL=True                      # required for TiDB Cloud / Aiven MySQL
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# RUN_SEED=true                    # seed demo data once on build, then remove
# ADMIN_PASSWORD=choose-a-strong-password
# VIEWER_PASSWORD=choose-a-strong-password
